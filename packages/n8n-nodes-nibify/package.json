{
  "name": "n8n-nodes-nibify",
  "version": "0.0.2",
  "description": "The Nibify community node for n8n: ask a person on their phone and wait for the answer, or send them a notification.",
  "license": "MIT",
  "author": {
    "name": "Francesco Fera",
    "email": "francescofera157@gmail.com"
  },
  "homepage": "https://github.com/nibify/nibify-sdk/tree/main/packages/n8n-nodes-nibify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nibify/nibify-sdk.git",
    "directory": "packages/n8n-nodes-nibify"
  },
  "bugs": {
    "url": "https://github.com/nibify/nibify-sdk/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "nibify",
    "human-in-the-loop"
  ],
  "files": [
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-icons.mts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.mts\"",
    "generate": "node scripts/agent-types.mts"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/NibifyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Nibify/Nibify.node.js"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "0.35.0",
    "@types/node": "^20.19.43",
    "n8n-workflow": "2.42.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
