{
  "name": "Approve / reject",
  "description": "The PRD §6.1 surface as the A2UI v0.9 message sequence a renderer consumes. This is what the app produces from the persisted surface: one createSurface carrying the identity, the data model before the components so bindings resolve on first paint, then the component list. surfaceId is the requestId.",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "msg_01HXYZ",
        "catalogId": "https://nibify.app/catalogs/nibify/v1/catalog.json"
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "msg_01HXYZ",
        "value": { "note": "" }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "msg_01HXYZ",
        "components": [
          { "id": "root", "component": "Card", "child": "body" },
          {
            "id": "body",
            "component": "Column",
            "children": ["title", "detail", "note", "actions"]
          },
          {
            "id": "title",
            "component": "Text",
            "text": "Invio email di outreach",
            "variant": "h4"
          },
          {
            "id": "detail",
            "component": "Text",
            "text": "L'agente ha preparato **3 email**. Rivedi e approva."
          },
          {
            "id": "note",
            "component": "TextField",
            "label": "Nota (opzionale)",
            "value": { "path": "/note" },
            "variant": "longText"
          },
          {
            "id": "actions",
            "component": "Row",
            "justify": "spaceBetween",
            "children": ["reject", "approve"]
          },
          {
            "id": "reject",
            "component": "Button",
            "variant": "borderless",
            "child": "reject-lbl",
            "action": { "event": { "name": "reject", "context": {} } }
          },
          { "id": "reject-lbl", "component": "Text", "text": "Rifiuta" },
          {
            "id": "approve",
            "component": "Button",
            "variant": "primary",
            "child": "approve-lbl",
            "action": {
              "event": { "name": "approve", "context": { "note": { "path": "/note" } } }
            }
          },
          { "id": "approve-lbl", "component": "Text", "text": "Approva" }
        ]
      }
    }
  ]
}
