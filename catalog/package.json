{
  "name": "@nibify/catalog",
  "version": "2.0.0",
  "description": "The Nibify UI component catalog: an A2UI-conformant JSON Schema of the components an agent may use in a surface.",
  "license": "MIT",
  "homepage": "https://github.com/nibify/nibify-sdk/tree/main/catalog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nibify/nibify-sdk.git",
    "directory": "catalog"
  },
  "bugs": {
    "url": "https://github.com/nibify/nibify-sdk/issues"
  },
  "keywords": [
    "nibify",
    "a2ui",
    "catalog",
    "json-schema"
  ],
  "type": "module",
  "main": "catalog.json",
  "exports": {
    ".": "./catalog.json",
    "./min-catalog-version": "./src/min-catalog-version.mjs",
    "./validator": "./src/validator.mjs",
    "./a2ui/*": "./vendor/a2ui/*",
    "./examples/*": "./examples/*"
  },
  "files": [
    "catalog.json",
    "src",
    "examples",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "ajv-formats": {
      "optional": true
    }
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
